# Track only project/ — everything else at repo root
# (docs, notes, editor configs) stays local-only.
/*
!/project/
!/.gitignore
!/.github/

# --- rules below apply inside project/ too ---

# dependencies
node_modules/

# build output
dist/
build/

# env files
.env
.env.local
.env.*.local

# editor / OS
.DS_Store
Thumbs.db

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
